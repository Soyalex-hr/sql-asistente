<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidSqlAsistentePackage">

    <!-- Menú principal "SQL Asistente" en la barra de menús de SSMS -->
    <Menus>
      <Menu guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>SQL Asistente</ButtonText>
          <CommandName>SQL Asistente</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- Grupo dentro del menú Tools (Herramientas) de SSMS -->
      <Group guid="guidSqlAsistenteCmdSet" id="GrupoEnHerramientas" priority="0x0050">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidSqlAsistenteCmdSet" id="GrupoFormato" priority="0x0100">
        <Parent guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" />
      </Group>
      <Group guid="guidSqlAsistenteCmdSet" id="GrupoAnalisis" priority="0x0200">
        <Parent guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" />
      </Group>
      <Group guid="guidSqlAsistenteCmdSet" id="GrupoRefactor" priority="0x0300">
        <Parent guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" />
      </Group>
      <Group guid="guidSqlAsistenteCmdSet" id="GrupoEsquema" priority="0x0400">
        <Parent guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" />
      </Group>
      <Group guid="guidSqlAsistenteCmdSet" id="GrupoNavegacion" priority="0x0150">
        <Parent guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" />
      </Group>
      <Group guid="guidSqlAsistenteCmdSet" id="GrupoCodigo" priority="0x0350">
        <Parent guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" />
      </Group>
      <Group guid="guidSqlAsistenteCmdSet" id="GrupoOtros" priority="0x0500">
        <Parent guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdFormatear" priority="0x0100" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoFormato" />
        <Strings>
          <ButtonText>Formatear SQL</ButtonText>
          <CanonicalName>SQLAsistente.FormatearSQL</CanonicalName>
          <LocCanonicalName>SQLAsistente.FormatearSQL</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdMayusculas" priority="0x0101" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoFormato" />
        <Strings>
          <ButtonText>Solo palabras clave en MAYÚSCULAS</ButtonText>
          <CanonicalName>SQLAsistente.Mayusculas</CanonicalName>
          <LocCanonicalName>SQLAsistente.Mayusculas</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSqlAsistenteCmdSet" id="cmdAnalizar" priority="0x0100" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoAnalisis" />
        <Strings>
          <ButtonText>Analizar código</ButtonText>
          <CanonicalName>SQLAsistente.AnalizarCodigo</CanonicalName>
          <LocCanonicalName>SQLAsistente.AnalizarCodigo</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdLimpiarAnalisis" priority="0x0101" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoAnalisis" />
        <Strings>
          <ButtonText>Limpiar resultados del análisis</ButtonText>
          <CanonicalName>SQLAsistente.LimpiarAnalisis</CanonicalName>
          <LocCanonicalName>SQLAsistente.LimpiarAnalisis</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSqlAsistenteCmdSet" id="cmdExpandirAsterisco" priority="0x0100" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoRefactor" />
        <Strings>
          <ButtonText>Expandir SELECT * a columnas</ButtonText>
          <CanonicalName>SQLAsistente.ExpandirAsterisco</CanonicalName>
          <LocCanonicalName>SQLAsistente.ExpandirAsterisco</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdCalificarEsquema" priority="0x0101" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoRefactor" />
        <Strings>
          <ButtonText>Agregar esquema (dbo.) a las tablas</ButtonText>
          <CanonicalName>SQLAsistente.CalificarEsquema</CanonicalName>
          <LocCanonicalName>SQLAsistente.CalificarEsquema</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSqlAsistenteCmdSet" id="cmdRefrescarEsquema" priority="0x0100" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoEsquema" />
        <Strings>
          <ButtonText>Actualizar tablas y columnas (caché)</ButtonText>
          <CanonicalName>SQLAsistente.RefrescarEsquema</CanonicalName>
          <LocCanonicalName>SQLAsistente.RefrescarEsquema</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdEstadoConexion" priority="0x0101" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoEsquema" />
        <Strings>
          <ButtonText>Ver estado de la conexión</ButtonText>
          <CanonicalName>SQLAsistente.EstadoConexion</CanonicalName>
          <LocCanonicalName>SQLAsistente.EstadoConexion</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSqlAsistenteCmdSet" id="cmdAbrirHistorial" priority="0x0100" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoOtros" />
        <Strings>
          <ButtonText>Abrir historial de consultas</ButtonText>
          <CanonicalName>SQLAsistente.AbrirHistorial</CanonicalName>
          <LocCanonicalName>SQLAsistente.AbrirHistorial</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdAbrirOpciones" priority="0x0101" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoOtros" />
        <Strings>
          <ButtonText>Opciones...</ButtonText>
          <CanonicalName>SQLAsistente.Opciones</CanonicalName>
          <LocCanonicalName>SQLAsistente.Opciones</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdEjecutarSentencia" priority="0x0100" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoNavegacion" />
        <Strings>
          <ButtonText>Ejecutar solo la sentencia actual</ButtonText>
          <CanonicalName>SQLAsistente.EjecutarSentencia</CanonicalName>
          <LocCanonicalName>SQLAsistente.EjecutarSentencia</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdIrADefinicion" priority="0x0101" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoNavegacion" />
        <Strings>
          <ButtonText>Ir a la definición (script del objeto)</ButtonText>
          <CanonicalName>SQLAsistente.IrADefinicion</CanonicalName>
          <LocCanonicalName>SQLAsistente.IrADefinicion</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdQuienUsa" priority="0x0102" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoNavegacion" />
        <Strings>
          <ButtonText>¿Quién usa este objeto?</ButtonText>
          <CanonicalName>SQLAsistente.QuienUsa</CanonicalName>
          <LocCanonicalName>SQLAsistente.QuienUsa</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdBuscarObjetos" priority="0x0103" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoNavegacion" />
        <Strings>
          <ButtonText>Buscar objetos...</ButtonText>
          <CanonicalName>SQLAsistente.BuscarObjetos</CanonicalName>
          <LocCanonicalName>SQLAsistente.BuscarObjetos</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdRenombrar" priority="0x0102" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoRefactor" />
        <Strings>
          <ButtonText>Renombrar alias o variable...</ButtonText>
          <CanonicalName>SQLAsistente.Renombrar</CanonicalName>
          <LocCanonicalName>SQLAsistente.Renombrar</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdClaseCSharp" priority="0x0100" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoCodigo" />
        <Strings>
          <ButtonText>Generar clase C# (tabla o consulta)</ButtonText>
          <CanonicalName>SQLAsistente.ClaseCSharp</CanonicalName>
          <LocCanonicalName>SQLAsistente.ClaseCSharp</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdLlamadaCSharp" priority="0x0101" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoCodigo" />
        <Strings>
          <ButtonText>Generar llamada C# del procedimiento</ButtonText>
          <CanonicalName>SQLAsistente.LlamadaCSharp</CanonicalName>
          <LocCanonicalName>SQLAsistente.LlamadaCSharp</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdDatosInsert" priority="0x0102" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoCodigo" />
        <Strings>
          <ButtonText>Copiar resultados como INSERT</ButtonText>
          <CanonicalName>SQLAsistente.DatosInsert</CanonicalName>
          <LocCanonicalName>SQLAsistente.DatosInsert</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdDatosJson" priority="0x0103" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoCodigo" />
        <Strings>
          <ButtonText>Copiar resultados como JSON</ButtonText>
          <CanonicalName>SQLAsistente.DatosJson</CanonicalName>
          <LocCanonicalName>SQLAsistente.DatosJson</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdRecuperarPestanas" priority="0x0099" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoOtros" />
        <Strings>
          <ButtonText>Recuperar pestañas...</ButtonText>
          <CanonicalName>SQLAsistente.RecuperarPestanas</CanonicalName>
          <LocCanonicalName>SQLAsistente.RecuperarPestanas</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlAsistenteCmdSet" id="cmdEditarFragmentos" priority="0x0100" type="Button">
        <Parent guid="guidSqlAsistenteCmdSet" id="GrupoOtros" />
        <Strings>
          <ButtonText>Editar mis fragmentos (snippets)</ButtonText>
          <CanonicalName>SQLAsistente.EditarFragmentos</CanonicalName>
          <LocCanonicalName>SQLAsistente.EditarFragmentos</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!--
    SSMS 22 arma su barra de menús de otra forma que Visual Studio: el grupo IDG_VS_MM_TOOLSADDINS
    puede no mostrarse. Por eso el menú "SQL Asistente" también se coloca dentro de Tools.
  -->
  <CommandPlacements>
    <CommandPlacement guid="guidSqlAsistenteCmdSet" id="MenuPrincipal" priority="0x0100">
      <Parent guid="guidSqlAsistenteCmdSet" id="GrupoEnHerramientas" />
    </CommandPlacement>
  </CommandPlacements>

  <!-- Atajos de teclado (se pueden cambiar en Herramientas > Opciones > Entorno > Teclado, buscando "SQLAsistente") -->
  <KeyBindings>
    <KeyBinding guid="guidSqlAsistenteCmdSet" id="cmdFormatear" editor="guidVSStd97" key1="K" mod1="Control" key2="Y" mod2="Control" />
    <KeyBinding guid="guidSqlAsistenteCmdSet" id="cmdAnalizar" editor="guidVSStd97" key1="K" mod1="Control" key2="A" mod2="Control" />
    <KeyBinding guid="guidSqlAsistenteCmdSet" id="cmdExpandirAsterisco" editor="guidVSStd97" key1="K" mod1="Control" key2="E" mod2="Control" />
    <KeyBinding guid="guidSqlAsistenteCmdSet" id="cmdEjecutarSentencia" editor="guidVSStd97" key1="E" mod1="Control Shift" />
    <KeyBinding guid="guidSqlAsistenteCmdSet" id="cmdIrADefinicion" editor="guidVSStd97" key1="VK_F12" />
    <KeyBinding guid="guidSqlAsistenteCmdSet" id="cmdRenombrar" editor="guidVSStd97" key1="VK_F2" />
  </KeyBindings>

